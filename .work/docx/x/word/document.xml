numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Live risk index (0–100).</w:t></w:r><w:r><w:t xml:space="preserve"> Merges radiation dose, HRV and sleep debt into a single number.</w:t></w:r></w:p><w:p w14:paraId="19932559" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Interaction model.</w:t></w:r><w:r><w:t xml:space="preserve"> These stressors compound instead of simply adding up, so a tired crew is hit harder by the same radiation.</w:t></w:r></w:p><w:p w14:paraId="3D0C96FB" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Offline edge engine.</w:t></w:r><w:r><w:t xml:space="preserve"> All calculations stay on the device, so the app works with no connection at all.</w:t></w:r></w:p><w:p w14:paraId="1E28534B" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Scenario buttons.</w:t></w:r><w:r><w:t xml:space="preserve"> Jump between calm orbit, a sleep-deprived crew and an acute solar storm. One click shows how the whole system reacts.</w:t></w:r></w:p><w:p w14:paraId="0C1025E3" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>40-hour telemetry simulation.</w:t></w:r><w:r><w:t xml:space="preserve"> Shows risk climbing over time and tiers shifting from nominal to elevated to emergency.</w:t></w:r></w:p><w:p w14:paraId="628A2D6F" w14:textId="73CA3957" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Crew avatar.</w:t></w:r><w:r><w:t xml:space="preserve"> Breaks the overall score into organ systems so the most strained part of the body is visible.</w:t></w:r></w:p><w:p w14:paraId="69FDEF76" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Crew Quarters.</w:t></w:r><w:r><w:t xml:space="preserve"> Shows a sleeping astronaut and their organs in one scene, making sleep and recovery part of the picture.</w:t></w:r></w:p><w:p w14:paraId="4DD87089" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Image assessment.</w:t></w:r><w:r><w:t xml:space="preserve"> Reads a photo of the eye or skin and returns color and pupil cues. It is rule-based and states clearly that it is not a diagnosis.</w:t></w:r></w:p><w:p w14:paraId="03621C7A" w14:textId="5042813B" w:rsidR="00D372BA" w:rsidRDefault="00B358A0"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Validity</w:t></w:r></w:p><w:p w14:paraId="65EB2C97" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>“How it is computed” panels.</w:t></w:r><w:r><w:t xml:space="preserve"> Every number can be opened and explained. Nothing is a black box.</w:t></w:r></w:p><w:p w14:paraId="0A1A8682" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Honest labelling.</w:t></w:r><w:r><w:t xml:space="preserve"> Each value is tagged simulated, derived or not modeled, so a simulation is never mistaken for a measurement.</w:t></w:r></w:p><w:p w14:paraId="36A6E10D" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Data and Validation area.</w:t></w:r><w:r><w:t xml:space="preserve"> The validation tab compares our radiation model with published Curiosity rover results and admits where it falls short. The sensitivity tab shows which assumptions move the result most. The sources tab lists every reference.</w:t></w:r></w:p><w:p w14:paraId="3B146F90" w14:textId="22F88722" w:rsidR="00D372BA" w:rsidRDefault="005B2BF8"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>AI Assistant</w:t></w:r></w:p><w:p w14:paraId="324BB50E" w14:textId="7DA707C6" w:rsidR="00D372BA" w:rsidRDefault="005B2BF8"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">NOVA AI </w:t></w:r><w:r><w:t xml:space="preserve">is a chatbot available to answer questions through </w:t></w:r><w:r w:rsidR="00EF62A2"><w:t>text or voice.</w:t></w:r></w:p><w:p w14:paraId="1D6DA039" w14:textId="4B9D99E9" w:rsidR="00D372BA" w:rsidRDefault="005B2BF8"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Simulated guided tutorials</w:t></w:r></w:p><w:p w14:paraId="11A85EC9" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Mars atlas and terrain tools.</w:t></w:r><w:r><w:t xml:space="preserve"> Place dose and conditions at real locations so mission planners can compare sites.</w:t></w:r></w:p><w:p w14:paraId="034901B7" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Guided tour and three languages.</w:t></w:r><w:r><w:t xml:space="preserve"> Anyone can open it, learn it and test the claims for themselves.</w:t></w:r></w:p><w:p w14:paraId="22D381E7" w14:textId="28B7FB90" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>What Is Real and What Is Simulated</w:t></w:r></w:p><w:p w14:paraId="4314EE06" w14:textId="5372AEFA" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>In our demo,</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00EF62A2"><w:t xml:space="preserve">we don’t have actual hardware, so </w:t></w:r><w:r><w:t>sensor inputs are simulated from three parameters: sleep debt, radiation exposure and mission time.</w:t></w:r></w:p><w:p w14:paraId="14FC3A11" w14:textId="753E1988" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>In a flight version,</w:t></w:r><w:r><w:t xml:space="preserve"> the same inputs would come live from the tri-node hardware and crew dosimetry.</w:t></w:r></w:p><w:p w14:paraId="2B4C6882" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Outputs are decision support, not diagnosis.</w:t></w:r><w:r><w:t xml:space="preserve"> RCPT flags risk and explains it. It does not replace medical judgment.</w:t></w:r></w:p><w:p w14:paraId="74926EA6" w14:textId="31383FE6" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Conclusion</w:t></w:r></w:p><w:p w14:paraId="30ABCECA" w14:textId="6CEE0D76" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pBdr><w:left w:val="single" w:sz="24" w:space="12" w:color="C2410C"/></w:pBdr><w:spacing w:before="60" w:after="120" w:line="288" w:lineRule="auto"/><w:ind w:left="240"/></w:pPr><w:r><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t xml:space="preserve">The difference our solution makes is that </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t>health awareness moves from Earth to the crew itself.</w:t></w:r><w:r><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t xml:space="preserve"> Instead of waiting 44 minutes for an answer, astronauts get a continuous, explainable picture of their own condition, built from </w:t></w:r><w:r w:rsidR="009D7293"><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t xml:space="preserve">light-weight wearable </w:t></w:r><w:r><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t xml:space="preserve">sensors and software that never needs a signal home. It </w:t></w:r><w:r w:rsidR="009D7293"><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t>is</w:t></w:r><w:r><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t xml:space="preserve"> simple enough to use under stress, </w:t></w:r><w:r w:rsidR="009D7293"><w:rPr><w:sz w:val="23"/><w:szCs w:val="23"/></w:rPr><w:t>and stand by to act in emergencies.</w:t></w:r></w:p><w:sectPr w:rsidR="00D372BA"><w:footerReference w:type="default" r:id="rId8"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1300" w:right="1440" w:bottom="1200" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>