 w:sz="4" w:space="0" w:color="BFC8D4"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/></w:tcBorders><w:tcMar><w:top w:w="80" w:type="dxa"/><w:left w:w="110" w:type="dxa"/><w:bottom w:w="80" w:type="dxa"/><w:right w:w="110" w:type="dxa"/></w:tcMar></w:tcPr><w:p w14:paraId="7ED44B54" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Space-grade RISC-V multi-core processor aggregates all nodes; UWB / Wi-Fi 6E link to the habitat</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="027B5FFA" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00D372BA"><w:pPr><w:spacing w:after="120"/></w:pPr></w:p><w:p w14:paraId="521DB084" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Why this design works</w:t></w:r></w:p><w:p w14:paraId="5809A8B9" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Edge processing first.</w:t></w:r><w:r><w:t xml:space="preserve"> Head and chest nodes filter and digitize their own signals, so only clean, compact data travels. That saves power and bandwidth.</w:t></w:r></w:p><w:p w14:paraId="059A99DA" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>One hub, one link.</w:t></w:r><w:r><w:t xml:space="preserve"> Only the wrist hub talks to the habitat, which keeps the wireless footprint small and the data synchronized.</w:t></w:r></w:p><w:p w14:paraId="170CEF1A" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Always ready.</w:t></w:r><w:r><w:t xml:space="preserve"> The nodes are worn continuously, so the system already has a baseline when an emergency begins.</w:t></w:r></w:p><w:p w14:paraId="663D870B" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Built for the Martian environment</w:t></w:r></w:p><w:p w14:paraId="61729F97" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Radiation hardening:</w:t></w:r><w:r><w:t xml:space="preserve"> silicon-on-insulator microcontrollers and error-correcting memory protect against bit-flips from cosmic rays.</w:t></w:r></w:p><w:p w14:paraId="05614198" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Thermal control:</w:t></w:r><w:r><w:t xml:space="preserve"> electronics are encapsulated in thermally conductive, electrically insulating epoxy that passes heat into the suit’s liquid cooling garment.</w:t></w:r></w:p><w:p w14:paraId="7F1E209C" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Dust protection:</w:t></w:r><w:r><w:t xml:space="preserve"> sealed housings (IP69K-equivalent) with PTFE membranes keep out abrasive, electrostatically charged regolith.</w:t></w:r></w:p><w:p w14:paraId="41D5E9F2" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Low-gravity securement:</w:t></w:r><w:r><w:t xml:space="preserve"> elastomeric tensioners and micro-boa dials hold electrodes against the skin. Capacitive sensors track skin contact and warn the wearer if a node loses it.</w:t></w:r></w:p><w:p w14:paraId="467CCAB2" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>How hardware feeds the software</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="9026" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:left w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:right w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="auto"/></w:tblBorders><w:tblCellMar><w:left w:w="10" w:type="dxa"/><w:right w:w="10" w:type="dxa"/></w:tblCellMar><w:tblLook w:val="0000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="0"/></w:tblPr><w:tblGrid><w:gridCol w:w="3200"/><w:gridCol w:w="5826"/></w:tblGrid><w:tr w:rsidR="00D372BA" w14:paraId="1D7006DE" w14:textId="77777777"><w:trPr><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3200" w:type="dxa"/><w:tcBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFC8