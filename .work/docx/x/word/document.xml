"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/></w:tcBorders><w:tcMar><w:top w:w="80" w:type="dxa"/><w:left w:w="110" w:type="dxa"/><w:bottom w:w="80" w:type="dxa"/><w:right w:w="110" w:type="dxa"/></w:tcMar></w:tcPr><w:p w14:paraId="6DBD6C9F" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>EEG from dry Ag/AgCl comb electrodes, focused on alpha (8–12 Hz) and beta (13–30 Hz) activity</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:tcBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/></w:tcBorders><w:tcMar><w:top w:w="80" w:type="dxa"/><w:left w:w="110" w:type="dxa"/><w:bottom w:w="80" w:type="dxa"/><w:right w:w="110" w:type="dxa"/></w:tcMar></w:tcPr><w:p w14:paraId="16FD0CBF" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Cognitive load, alertness and fatigue; early signs of brain strain</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2526" w:type="dxa"/><w:tcBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFC8D4"/></w:tcBorders><w:tcMar><w:top w:w="80" w:type="dxa"/><w:left w:w="110" w:type="dxa"/><w:bottom w:w="80" w:type="dxa"/><w:right w:w="110" w:type="dxa"/></w:tcMar></w:tcPr><w:p w14:paraId="04DEADF8" w14:textId="77777777" w:rsidR="00D372BA" w:rsidRDefault="00000000"><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Dedicated EEG front-end chip, Cortex-M4 microcontroller, BLE 5