# RCPT backend settings. Copy this file to .env and fill in the values.
# (The launcher creates .env from this file automatically if .env is missing.)

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=space_health
DB_USER=postgres
DB_PASSWORD=

# --- Web server ---
# PORT=5000

# --- AI provider for Nova chat and alert messages ---
# Google Gemini is used automatically as soon as GOOGLE_API_KEY has a value.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
# Other models: gemini-3.8-flash, gemini-4-hydrogen (smarter, slower)
# AI_PROVIDER=google

# NVIDIA NIM (used only while GOOGLE_API_KEY is empty, or with AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
